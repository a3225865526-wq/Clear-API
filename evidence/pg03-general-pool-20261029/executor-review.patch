@@ -0,0 +1,262 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"slices"
+	"time"
+)
+
+// PoolModelSync never accepts a client-supplied model list. The operator opts
+// an identity into automatic models in its existing, protected grant floor.
+type PoolModelSync struct {
+	ExpectedRevision uint64                  `json:"expected_revision"`
+	Identity         PoolIdentityExpectation `json:"identity"`
+}
+
+type poolModelDiscoverer interface {
+	DiscoverPoolModels(context.Context, *Auth) ([]string, error)
+}
+
+// SyncPoolAccountModels reconciles provider support and renews only an enabled,
+// unexpired operator grant. It cannot promote trust or restore an expired,
+// disabled, replaced, or explicitly revoked identity/model.
+func (m *Manager) SyncPoolAccountModels(ctx context.Context, command PoolModelSync) error {
+	if m == nil || m.poolGuard == nil || m.poolGuard.role != "service" {
+		return ErrPoolGuard
+	}
+	if command.Identity.IdentityVersion != CredentialSecurityIdentityVersion {
+		return ErrPoolGuard
+	}
+	m.mu.RLock()
+	a := m.auths[command.Identity.AuthID]
+	if a == nil {
+		m.mu.RUnlock()
+		return ErrPoolGuard
+	}
+	snapshot := a.Clone()
+	executor, ok := m.executorLocked(executorKeyFromAuth(a))
+	m.mu.RUnlock()
+	if wrapped, pool := executor.(*poolExecutor); pool {
+		executor = wrapped.ProviderExecutor
+	}
+	discoverer, supported := executor.(poolModelDiscoverer)
+	if !ok || !supported || snapshot.Provider != command.Identity.Provider || PoolCredentialDigest(snapshot) != command.Identity.CredentialDigest {
+		return ErrPoolGuard
+	}
+	guard := m.poolGuard
+	guard.mu.Lock()
+	record, readErr := m.poolGrants()
+	permitted := false
+	if readErr == nil && record.Revision == command.ExpectedRevision {
+		now := time.Now().Unix()
+		if guard.now != nil {
+			now = guard.now().Unix()
+		}
+		for _, grant := range record.Grants {
+			if grant.AuthID == snapshot.ID && grant.AutomaticModels && grant.Enabled && grant.Provider == snapshot.Provider && grant.CredentialDigest == command.Identity.CredentialDigest && grant.ExpiresAt > now && grant.ExpiresAt <= now+1800 {
+				permitted = true
+			}
+		}
+		guard.journalMu.Lock()
+		trust := guard.trust[snapshot.ID]
+		permitted = permitted && trust.Generation == command.Identity.Generation && trust.State != PoolTrustRevoked && (trust.AuthID == "" || trust.CredentialDigest == command.Identity.CredentialDigest && trust.Provider == snapshot.Provider)
+		guard.journalMu.Unlock()
+	}
+	guard.mu.Unlock()
+	if !permitted {
+		return ErrPoolGuard
+	}
+	models, err := discoverer.DiscoverPoolModels(ctx, snapshot)
+	if err != nil {
+		return err
+	}
+	if len(models) == 0 || len(models) > 4096 {
+		return ErrPoolGuard
+	}
+	slices.Sort(models)
+	for i, model := range models {
+		if model != canonicalPoolModel(model) || i > 0 && models[i-1] == model {
+			return ErrPoolGuard
+		}
+	}
+	err = m.commitAutomaticPoolModels(ctx, command, snapshot, models)
+	if err != nil {
+		return err
+	}
+	return m.syncPoolRegistry(ctx)
+}
+
+func (m *Manager) commitAutomaticPoolModels(ctx context.Context, command PoolModelSync, snapshot *Auth, models []string) (resultErr error) {
+	guard := m.poolGuard
+	guard.mu.Lock()
+	defer guard.mu.Unlock()
+	if _, err := m.poolGrants(); err != nil {
+		return err
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	a := m.auths[snapshot.ID]
+	if a == nil || a.Generation != snapshot.Generation || a.AuthKind() != AuthKindOAuth || PoolCredentialDigest(a) != command.Identity.CredentialDigest {
+		return ErrPoolGuard
+	}
+	guard.journalMu.Lock()
+	file, err := guard.openPoolCheckpoint()
+	if err != nil {
+		guard.journalMu.Unlock()
+		return err
+	}
+	defer func() {
+		unlockPoolCheckpoint(file)
+		if file.Close() != nil {
+			guard.faulted.Store(true)
+			resultErr = ErrPoolGuard
+		}
+	}()
+	floor, size, err := guard.readPoolCheckpoint(file)
+	record, policyErr := guard.grants()
+	if err != nil || policyErr != nil || command.ExpectedRevision == 0 || command.ExpectedRevision == math.MaxUint64 || floor.Revision != command.ExpectedRevision || record.Revision != floor.Revision || poolRecordDigest(record) != floor.Digest {
+		guard.journalMu.Unlock()
+		return ErrPoolGuard
+	}
+	var trust PoolTrustRecord
+	for _, item := range floor.Trust {
+		if item.AuthID == a.ID {
+			trust = item
+			break
+		}
+	}
+	if trust.Generation != command.Identity.Generation || trust.State == PoolTrustRevoked || trust.AuthID != "" && (trust.CredentialDigest != command.Identity.CredentialDigest || trust.Provider != a.Provider) {
+		guard.journalMu.Unlock()
+		return ErrPoolGuard
+	}
+	now := time.Now().Unix()
+	if guard.now != nil {
+		now = guard.now().Unix()
+	}
+	var grant *PoolGrant
+	for i := range record.Grants {
+		if record.Grants[i].AuthID == a.ID {
+			if grant != nil {
+				guard.journalMu.Unlock()
+				return ErrPoolGuard
+			}
+			grant = &record.Grants[i]
+		}
+	}
+	if grant == nil || !grant.AutomaticModels || !grant.Enabled || grant.Provider != a.Provider || grant.CredentialDigest != command.Identity.CredentialDigest || grant.ExpiresAt <= now || grant.ExpiresAt > now+1800 {
+		guard.journalMu.Unlock()
+		return ErrPoolGuard
+	}
+	grant.Models = slices.Clone(models)
+	grant.ExpiresAt = now + 1800
+	nextCaps := make([]PoolModelCapability, 0, len(record.Capabilities)+len(models))
+	explicit := make(map[string]bool)
+	for _, item := range record.Capabilities {
+		if item.AuthID == a.ID && item.Source == "provider_manifest" {
+			continue
+		}
+		nextCaps = append(nextCaps, item)
+		if item.AuthID == a.ID {
+			explicit[item.Model] = true
+		}
+	}
+	if trust.State == PoolTrustTrusted {
+		for _, model := range models {
+			if !explicit[model] {
+				nextCaps = append(nextCaps, PoolModelCapability{AuthID: a.ID, Provider: a.Provider, CredentialDigest: command.Identity.CredentialDigest, Model: model, State: PoolCapabilityVerified, Generation: trust.Generation, IdentityVersion: CredentialSecurityIdentityVersion, Source: "provider_manifest"})
+			}
+		}
+	}
+	record.Capabilities = nextCaps
+	record.Revision++
+	nextTrust := slices.Clone(floor.Trust)
+	for i := range nextTrust {
+		if nextTrust[i].State == PoolTrustTrusted {
+			nextTrust[i].AuthorizationVersion = record.Revision
+		}
+	}
+	next := poolCheckpoint{GuardVersion: PoolGuardVersion, ExecutorID: guard.executorID, Revision: record.Revision, Digest: poolRecordDigest(record), Trust: nextTrust}
+	if !validPoolTrust(next) || !validPoolCapabilities(record) {
+		guard.journalMu.Unlock()
+		return ErrPoolGuard
+	}
+	if err = writePoolPolicy(guard.file, record); err == nil {
+		err = guard.appendPoolCheckpoint(file, size, next)
+	}
+	if err != nil {
+		guard.journalMu.Unlock()
+		guard.faulted.Store(true)
+		guard.cancelPoolLeases(ErrPoolGuard)
+		return err
+	}
+	guard.installPoolCheckpoint(next)
+	guard.journalMu.Unlock()
+	// Pure renewal and additions preserve current leases. Removed/revoked model
+	// authority cancels locally; it never creates a new execution attempt.
+	for _, lease := range guard.leases {
+		currentTrust, trusted := guard.trusted(lease.auth, record.Revision)
+		if !trusted || currentTrust.Generation != lease.Generation || m.poolModelCheck(record, lease.auth, lease.req.Model, lease.caps) != nil {
+			lease.cancel(ErrPoolGuard)
+			continue
+		}
+		lease.AuthorizationVersion = record.Revision
+	}
+	return nil
+}
+
+// AutomaticPoolModels feeds the existing registry; it does not create a second
+// scheduler or bypass the dispatch-time trust/capability checks.
+func (m *Manager) AutomaticPoolModels(a *Auth) ([]string, bool) {
+	if m == nil || m.poolGuard == nil || a == nil {
+		return nil, false
+	}
+	m.poolGuard.mu.Lock()
+	defer m.poolGuard.mu.Unlock()
+	record, err := m.poolGrants()
+	if err != nil {
+		return nil, true
+	}
+	for _, grant := range record.Grants {
+		if grant.AuthID == a.ID && grant.AutomaticModels {
+			if grant.CredentialDigest != PoolCredentialDigest(a) {
+				return nil, true
+			}
+			return slices.Clone(grant.Models), true
+		}
+	}
+	return nil, false
+}
+
+// RefreshAutomaticPoolModels uses one provider read per opted-in, trusted
+// identity. Failure leaves the last floor to expire; no retry or trust repair.
+func (m *Manager) RefreshAutomaticPoolModels(ctx context.Context) error {
+	_, identities, err := m.PoolTrustSnapshot()
+	if err != nil {
+		return err
+	}
+	var failures []error
+	for _, identity := range identities {
+		if identity.State != PoolTrustTrusted {
+			continue
+		}
+		a, ok := m.GetByID(identity.AuthID)
+		if !ok || a.Disabled || ManagementIsolation(a) {
+			continue
+		}
+		if _, automatic := m.AutomaticPoolModels(a); !automatic {
+			continue
+		}
+		revision, _, err := m.PoolTrustSnapshot()
+		if err != nil {
+			return err
+		}
+		err = m.SyncPoolAccountModels(ctx, PoolModelSync{ExpectedRevision: revision, Identity: PoolIdentityExpectation{AuthID: identity.AuthID, Provider: identity.Provider, CredentialDigest: identity.CredentialDigest, Generation: identity.Generation, IdentityVersion: CredentialSecurityIdentityVersion}})
+		if err != nil {
+			failures = append(failures, fmt.Errorf("automatic pool model refresh failed: %w", err))
+		}
+	}
+	return errors.Join(failures...)
+}
