+func TestPoolProviderModelDiscovery(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		status     int
+		valid      bool
+	}{
+		{"new-model", `{"models":[{"slug":"new-model"}]}`, 200, true},
+		{"empty", `{"models":[]}`, 200, false}, {"malformed", `{`, 200, false},
+		{"duplicate", `{"models":[{"slug":"a"},{"slug":"a"}]}`, 200, false},
+		{"wildcard", `{"models":[{"slug":"*"}]}`, 200, false},
+		{"denied", `{"error":"synthetic-secret-sentinel"}`, 403, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != "GET" || r.URL.Path != "/models" || r.URL.Query().Get("client_version") == "" || r.Header.Get("Authorization") != "Bearer synthetic" || r.Header.Get("ChatGPT-Account-ID") != "synthetic-account" {
+					t.Error("discovery request contract")
+				}
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer server.Close()
+			a := &coreauth.Auth{Provider: "codex", Attributes: map[string]string{coreauth.AttributeAuthKind: coreauth.AuthKindOAuth}, Metadata: map[string]any{"access_token": "synthetic", "account_id": "synthetic-account", "base_url": server.URL}}
+			models, err := runtimeexecutor.NewCodexAutoExecutor(&config.Config{}).DiscoverPoolModels(context.Background(), a)
+			if tc.valid {
+				if err != nil || len(models) != 1 || models[0] != "new-model" {
+					t.Fatalf("%v %v", models, err)
+				}
+			} else if err == nil || strings.Contains(err.Error(), "secret-sentinel") {
+				t.Fatalf("failure not sanitized: %v", err)
+			}
+		})
+	}
+}
