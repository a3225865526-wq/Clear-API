+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func (e *CodexAutoExecutor) DiscoverPoolModels(ctx context.Context, auth *cliproxyauth.Auth) ([]string, error) {
+	return e.httpExec.DiscoverPoolModels(ctx, auth)
+}
+
+// DiscoverPoolModels reads the account-scoped provider manifest using the same
+// credentials, proxy and TLS transport as execution. A shared/static catalog is
+// never evidence that an individual account can use a model.
+func (e *CodexExecutor) DiscoverPoolModels(ctx context.Context, auth *cliproxyauth.Auth) ([]string, error) {
+	if auth == nil || auth.AuthKind() != cliproxyauth.AuthKindOAuth {
+		return nil, fmt.Errorf("pool model discovery requires OAuth")
+	}
+	token, baseURL := codexCreds(auth)
+	if token == "" {
+		return nil, fmt.Errorf("pool model discovery credential unavailable")
+	}
+	if baseURL == "" {
+		baseURL = "https://chatgpt.com/backend-api/codex"
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, strings.TrimRight(baseURL, "/")+"/models?client_version=0.154.0", nil)
+	if err != nil {
+		return nil, fmt.Errorf("pool model discovery request invalid")
+	}
+	applyCodexHeadersFromSources(req, auth, token, false, e.cfg, nil)
+	req.Header.Set("Version", "0.154.0")
+	client := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 0)
+	// Provider redirects must not send account credentials to another origin.
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	response, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("pool model discovery transport failed")
+	}
+	defer func() { _ = response.Body.Close() }()
+	if response.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("pool model discovery HTTP %d", response.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, 2*1024*1024+1))
+	if err != nil || len(body) > 2*1024*1024 {
+		return nil, fmt.Errorf("pool model discovery response invalid")
+	}
+	var manifest struct {
+		Models []struct {
+			Slug string `json:"slug"`
+		} `json:"models"`
+	}
+	if json.Unmarshal(body, &manifest) != nil || len(manifest.Models) == 0 || len(manifest.Models) > 4096 {
+		return nil, fmt.Errorf("pool model discovery manifest invalid")
+	}
+	models := make([]string, 0, len(manifest.Models))
+	seen := make(map[string]bool, len(manifest.Models))
+	for _, item := range manifest.Models {
+		if item.Slug == "" || len(item.Slug) > 128 || strings.ContainsAny(item.Slug, " *\t\r\n\x00") || seen[item.Slug] {
+			return nil, fmt.Errorf("pool model discovery model invalid")
+		}
+		seen[item.Slug] = true
+		models = append(models, item.Slug)
+	}
+	return models, nil
+}
