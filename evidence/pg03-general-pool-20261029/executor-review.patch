+// Pool discovery is deliberately synthetic here; live manifests are recorded separately.
+type automaticModelExecutor struct {
+	syncTestExecutor
+	models  map[string][]string
+	failure error
+	ready   chan struct{}
+	permit  chan struct{}
+}
+
+func (*automaticModelExecutor) PoolDispatchFencing() bool { return true }
+func (e *automaticModelExecutor) Execute(ctx context.Context, a *coreauth.Auth, req ex.Request, opts ex.Options) (ex.Response, error) {
+	if e.ready != nil {
+		e.ready <- struct{}{}
+		select {
+		case <-e.permit:
+		case <-ctx.Done():
+			return ex.Response{}, ctx.Err()
+		}
+	}
+	if err := ex.BeforeUpstreamDispatch(ctx); err != nil {
+		return ex.Response{}, err
+	}
+	return ex.Response{Payload: []byte(a.ID)}, nil
+}
+
+func (e *automaticModelExecutor) DiscoverPoolModels(_ context.Context, a *coreauth.Auth) ([]string, error) {
+	if e.failure != nil {
+		return nil, e.failure
+	}
+	return append([]string(nil), e.models[a.ID]...), nil
+}
