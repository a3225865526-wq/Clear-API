+func TestPoolAutomaticModels(t *testing.T) {
+	t.Setenv("CLEARAPI_PG02_HTTP_NON_STREAM", "true")
+	t.Setenv("CLEARAPI_PG02_RESPONSES_SSE", "")
+	ctx := context.Background()
+	root := t.TempDir()
+	dir := filepath.Join(root, "auths")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	grants := filepath.Join(root, "grants.json")
+	checkpoint := filepath.Join(root, "checkpoint.jsonl")
+	t.Setenv("CLEARAPI_POOL_ROLE", "service")
+	t.Setenv("CLEARAPI_POOL_ADMISSION_FILE", grants)
+	t.Setenv("CLEARAPI_POOL_EXECUTOR_ID", "synthetic-automatic")
+	t.Setenv("CLEARAPI_POOL_CHECKPOINT_FILE", checkpoint)
+	if err := coreauth.ProvisionPoolCheckpoint(checkpoint, "synthetic-automatic"); err != nil {
+		t.Fatal(err)
+	}
+	cfg := &config.Config{AuthDir: dir}
+	m := coreauth.NewManager(nil, nil, nil)
+	m.SetConfig(cfg)
+	probe := &automaticModelExecutor{models: map[string][]string{"automatic-A": {"model-X", "model-Y", "model-Z"}, "automatic-B": {"model-X", "model-Y"}}}
+	m.RegisterExecutor(probe)
+	record := coreauth.PoolGrantFile{GuardVersion: coreauth.PoolGuardVersion, ExecutorID: "synthetic-automatic", Revision: 1}
+	auths := make([]*coreauth.Auth, 0, 2)
+	for _, id := range []string{"automatic-A", "automatic-B"} {
+		a := &coreauth.Auth{ID: id, Provider: "codex", FileName: id + ".json", Status: coreauth.StatusActive, Attributes: map[string]string{coreauth.AttributeAuthKind: coreauth.AuthKindOAuth}, Metadata: map[string]any{"access_token": "synthetic-unused", "account_id": id}}
+		auths = append(auths, a)
+		record.Grants = append(record.Grants, coreauth.PoolGrant{AuthID: id, Provider: "codex", CredentialDigest: coreauth.PoolCredentialDigest(a), AutomaticModels: true, Enabled: true, ExpiresAt: time.Now().Add(20 * time.Minute).Unix(), MaxConcurrency: 1, Capabilities: []string{"text_chat", "stream_text", "exact_usage"}, SourceEvidence: []string{"synthetic-source"}, TestEvidence: []string{"synthetic-test"}})
+	}
+	data, err := json.Marshal(record)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(grants, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	for i, a := range auths {
+		auths[i], err = m.Register(ctx, a)
+		if err != nil {
+			t.Fatal(err)
+		}
+		id := a.ID
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	}
+	s := &Service{cfg: cfg, coreManager: m}
+	m.SetPoolRegistrySync(s.syncPoolRegistry)
+	command := func(id string) coreauth.PoolModelSync {
+		rev, states, err := m.PoolTrustSnapshot()
+		if err != nil {
+			t.Fatal(err)
+		}
+		a, _ := m.GetByID(id)
+		identity := coreauth.PoolIdentityExpectation{AuthID: id, Provider: "codex", CredentialDigest: coreauth.PoolCredentialDigest(a), IdentityVersion: coreauth.CredentialSecurityIdentityVersion}
+		for _, state := range states {
+			if state.AuthID == id {
+				identity.Generation = state.Generation
+			}
+		}
+		return coreauth.PoolModelSync{ExpectedRevision: rev, Identity: identity}
+	}
+	// Bootstrap discovers models without promoting either identity.
+	for _, a := range auths {
+		if err = m.SyncPoolAccountModels(ctx, command(a.ID)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	rev, caps, err := m.PoolModelSnapshot()
+	if err != nil || len(caps) != 0 {
+		t.Fatalf("bootstrap granted capability: %v %v", caps, err)
+	}
+	ids := []coreauth.PoolIdentityExpectation{command(auths[0].ID).Identity, command(auths[1].ID).Identity}
+	if err = m.PromotePoolIdentities(ctx, coreauth.PoolPromotion{ExpectedRevision: rev, Identities: ids}); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.RefreshAutomaticPoolModels(ctx); err != nil {
+		t.Fatal(err)
+	}
+	for model, want := range map[string]int{"model-X": 2, "model-Y": 2, "model-Z": 1, "unsupported-model": 0} {
+		result, err := m.PoolRequestPreflight(ctx, model, ex.Options{OriginalRequest: []byte(`{"tools":[]}`)})
+		if err != nil || result.EligibleCount != want {
+			t.Fatalf("%s: eligible=%d want=%d err=%v", model, result.EligibleCount, want, err)
+		}
+	}
+
+	// A capability refresh must preserve an allocated, still-authorized lease.
+	probe.ready = make(chan struct{}, 1)
+	probe.permit = make(chan struct{})
+	completed := make(chan error, 1)
+	go func() {
+		_, err := m.Execute(ctx, []string{"codex"}, ex.Request{Model: "model-Z"}, ex.Options{})
+		completed <- err
+	}()
+	select {
+	case <-probe.ready:
+	case err := <-completed:
+		t.Fatalf("request ended before lease: %v", err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("lease not acquired")
+	}
+	if len(m.PoolInFlightSnapshot()) != 1 {
+		t.Fatal("allocated lease missing")
+	}
+	if _, err = m.Execute(ctx, []string{"codex"}, ex.Request{Model: "model-Z"}, ex.Options{}); err == nil {
+		t.Fatal("concurrency exceeded")
+	}
+	if err = m.SyncPoolAccountModels(ctx, command(auths[0].ID)); err != nil {
+		t.Fatal(err)
+	}
+	close(probe.permit)
+	if err = <-completed; err != nil {
+		t.Fatalf("renewal canceled valid lease: %v", err)
+	}
+	if len(m.PoolInFlightSnapshot()) != 0 {
+		t.Fatal("lease leaked")
+	}
+	probe.ready = nil
+	probe.permit = nil
+
+	invalidIdentity := command(auths[0].ID)
+	invalidIdentity.Identity.Generation++
+	if err = m.SyncPoolAccountModels(ctx, invalidIdentity); err == nil {
+		t.Fatal("stale identity generation accepted")
+	}
+	stale := command(auths[0].ID)
+	if err = m.SyncPoolAccountModels(ctx, stale); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.SyncPoolAccountModels(ctx, stale); err == nil {
+		t.Fatal("stale CAS accepted")
+	}
+	cmd := command(auths[0].ID)
+	if err = m.RevokePoolModelCapability(ctx, coreauth.PoolModelRevoke{ExpectedRevision: cmd.ExpectedRevision, Identity: cmd.Identity, Model: "model-X"}); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.RefreshAutomaticPoolModels(ctx); err != nil {
+		t.Fatal(err)
+	}
+	result, err := m.PoolRequestPreflight(ctx, "model-X", ex.Options{})
+	if err != nil || result.EligibleCount != 1 {
+		t.Fatalf("explicit revoke restored: %+v %v", result, err)
+	}
+	probe.models[auths[0].ID] = []string{"model-Y", "new-model-without-code-change"}
+	if err = m.SyncPoolAccountModels(ctx, command(auths[0].ID)); err != nil {
+		t.Fatal(err)
+	}
+	for model, want := range map[string]int{"model-Z": 0, "new-model-without-code-change": 1} {
+		result, err = m.PoolRequestPreflight(ctx, model, ex.Options{})
+		if err != nil || result.EligibleCount != want {
+			t.Fatalf("catalog change %s: %+v %v", model, result, err)
+		}
+	}
+	before, _, _ := m.PoolModelSnapshot()
+	probe.failure = errors.New("synthetic provider unavailable")
+	if err = m.RefreshAutomaticPoolModels(ctx); err == nil {
+		t.Fatal("provider failure hidden")
+	}
+	after, _, _ := m.PoolModelSnapshot()
+	if before != after {
+		t.Fatal("failed discovery renewed grant")
+	}
+	probe.failure = nil
+	// Concurrent identical commands cannot both advance the same policy floor.
+	cmd = command(auths[0].ID)
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() { defer wg.Done(); results <- m.SyncPoolAccountModels(ctx, cmd) }()
+	}
+	wg.Wait()
+	close(results)
+	successes := 0
+	for err := range results {
+		if err == nil {
+			successes++
+		}
+	}
+	if successes != 1 {
+		t.Fatalf("CAS successes=%d", successes)
+	}
+	// Identity revocation cannot be undone by automatic refresh.
+	cmd = command(auths[0].ID)
+	if err = m.RevokePoolIdentity(ctx, coreauth.PoolRevocation{ExpectedRevision: cmd.ExpectedRevision, Identity: cmd.Identity}); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.RefreshAutomaticPoolModels(ctx); err != nil {
+		t.Fatal(err)
+	}
+	result, err = m.PoolRequestPreflight(ctx, "new-model-without-code-change", ex.Options{})
+	if err != nil || result.EligibleCount != 0 {
+		t.Fatalf("revoked identity restored: %+v %v", result, err)
+	}
+	// An expired operator floor cannot be renewed or silently reauthorized.
+	raw, err := os.ReadFile(grants)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var expired coreauth.PoolGrantFile
+	if err = json.Unmarshal(raw, &expired); err != nil {
+		t.Fatal(err)
+	}
+	expired.Revision++
+	for i := range expired.Grants {
+		if expired.Grants[i].AuthID == auths[1].ID {
+			expired.Grants[i].ExpiresAt = time.Now().Add(-time.Minute).Unix()
+		}
+	}
+	raw, err = json.Marshal(expired)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(grants, raw, 0600); err != nil {
+		t.Fatal(err)
+	}
+	expiredCommand := command(auths[1].ID)
+	if err = m.SyncPoolAccountModels(ctx, expiredCommand); err == nil {
+		t.Fatal("expired grant renewed")
+	}
+	finalRevision, _, err := m.PoolModelSnapshot()
+	if err != nil || finalRevision != expiredCommand.ExpectedRevision {
+		t.Fatal("expired floor changed")
+	}
+
+}
