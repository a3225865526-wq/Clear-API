# ClearAPI production deploy configuration template.
# This file overrides inherited DEPLOY_* variables; defaults apply afterwards.
#
# Copy to /opt/clearapi/config/deploy.env on the VPS, mode 0600, root-owned.
# Values below were verified against the live VPS during CI/CD acceptance
# (2026-10-07); only override where reality diverges. NEVER put secrets in
# this file — the GHCR pull token lives in its own file
# (DEPLOY_GHCR_TOKEN_FILE) and the migration DSN is read from the container
# secret /run/secrets/sql_dsn.

# --- layout (live-verified) ---
#DEPLOY_APP_DIR=/opt/clearapi/app
#DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
#DEPLOY_SERVICE=new-api
#DEPLOY_PG_SERVICE=postgres
#DEPLOY_PG_USER=clearapi_app
#DEPLOY_PG_DB=clearapi
#DEPLOY_NETWORK_NAME=clearapi_internal

# --- registry ---
#DEPLOY_IMAGE_BASE=ghcr.io/a3225865526-wq/clearapi
#DEPLOY_GHCR_USER=clearapi-deploy
#DEPLOY_GHCR_TOKEN_FILE=/opt/clearapi/secrets/ghcr-pull-token

# --- backup hard gate ---
#DEPLOY_BACKUP_SERVICE=clearapi-backup.service
#DEPLOY_BACKUP_TIMER=clearapi-backup.timer
#DEPLOY_BACKUP_DIR=/opt/clearapi/backups

# --- health ---
#DEPLOY_LOCAL_HEALTH_URL=http://127.0.0.1:3000/api/status
#DEPLOY_PUBLIC_HEALTH_URL=https://www.clear999.com/api/status

# --- edge baseline (H4 frozen post-real-IP state, live-verified) ---
#DEPLOY_CADDYFILE=/opt/clearapi/edge/Caddyfile
#DEPLOY_CADDYFILE_MD5=295647360d0db904c6208b79411d5408

# --- gates ---
#DEPLOY_VERIFY_BOOTSTRAP=true
#DEPLOY_BOOTSTRAP_SERVICE=production-bootstrap
# Only set for candidates that ship pending additive migrations, e.g.:
#DEPLOY_MIGRATION_FLAGS=
#   DEPLOY_MIGRATION_FLAGS=-apply-approved-billing-auth-snapshots-v1

# --- frozen negative-gate expectations (H4 baseline, live-verified) ---
#DEPLOY_LAUNCH_BASELINE=closed
# Commercial opening validates enabled channels, abilities and effective pricing dynamically:
#DEPLOY_LAUNCH_BASELINE=commercial
# Optional additional channel IDs that the operator requires to remain disabled.
# Commercial defaults do not reserve any channel ID.
#DEPLOY_EXPECT_CHANNELS=
# CLOSED_LAUNCH is always checked independently against the selected baseline.
#DEPLOY_EXPECT_ENV_KEYS='CLEARAPI_ENABLE_REALTIME=false'
#DEPLOY_EXPECT_CHANNELS=1,2
# user2 = the second user account (billing-acceptance, id=2)
#DEPLOY_EXPECT_USER_ID=2
# token1/2 = billing-acceptance-a1 (id=1), billing-acceptance-rerun (id=2)
#DEPLOY_EXPECT_TOKEN_IDS=1,2
# needs_review reservation (reserved/target/applied) frozen set
#DEPLOY_EXPECT_REVIEW_ROWS='4/10/4 41/93/41'
#DEPLOY_EXPECT_EMPTY_TABLES=store_products,top_ups,offline_orders,subscription_orders
#DEPLOY_POOL_OPTION_PATTERN=%pool%

# --- Runtime Integrity Gate (strict Report v1 consumer) ---
# Inherited values cannot authorize these settings; deploy.env is authoritative.
CLEARAPI_STORE_POLICY=disabled
# "approved" is reserved for a separately approved future release and BLOCKED
# in Stage 2B-2. No store flag, publication or unified view is changed here.
#DEPLOY_EXPECT_REFERRAL_ENABLED=false
# Existing root dashboard access JWT: separate root:root 0600 regular file.
# Never put credentials in this file, argv, the GHCR stdin stream or CI logs.
# No login, token issuance, anonymous request or SQL fallback is performed.
#DEPLOY_RUNTIME_PROBE_TOKEN_FILE=/opt/clearapi/secrets/runtime-probe-session
# Required HTTP response: success=true, data=Runtime Integrity Report v1.
# data: schema_version="1", report_version="1", status="PASS",
# instance_id=<process UUID v4>, container_id=<Docker .Id>, started_at=<Docker .State.StartedAt>,
# build_identity=sha256:<image /new-api binary>, config_generation=sha256:<64hex>, config_digest=sha256:<64hex>,
# online_payment_enabled=false, store_enabled=false, billing_mode=off,
# referral_enabled=<policy>, pool_enabled=false, approval_schema=1,
# catalog_version>0, effective_product_count=0, approval_view_digest=sha256:<64hex>,
# product_view_digest=sha256:<64hex>, generated_at=<timezone-aware fresh RFC3339 timestamp>.
# effective_product_count must cover the validated approval AND legacy view;
# an empty projection caused only by a disabled store flag is not evidence.
# Container metadata must originate from host Docker inspect, be mounted read-only
# at /run/clearapi/runtime-identity.json (root:root 0400), and match the kernel
# container ID. Do not manufacture identity from environment values or hostname.
# Missing metadata or the unversioned Stage 2B-1 Probe remains BLOCKED. Provisioning
# the production identity channel and real integration require separate approval.

# --- records ---
#DEPLOY_AUDIT_LOG=/opt/clearapi/logs/deployments.log
#DEPLOY_MANIFEST=/opt/clearapi/app/release-manifest.json
#DEPLOY_OVERRIDE_FILE=/opt/clearapi/app/compose-candidate.yaml
